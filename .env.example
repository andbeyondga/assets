# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — your keys never get committed.

# ── Phase 1: the brain (required now) ──────────────────────────────
# Anthropic / Claude API key — get it at https://console.anthropic.com
ANTHROPIC_API_KEY=

# ── Phase 2: voice (add later) ─────────────────────────────────────
# ElevenLabs API key for voice output — https://elevenlabs.io
ELEVENLABS_API_KEY=
# The voice ID to speak in (your custom voice). Find it in the ElevenLabs app.
ELEVENLABS_VOICE_ID=
# OpenAI API key — used for Whisper speech-to-text — https://platform.openai.com
OPENAI_API_KEY=

# ── Phase 3: memory + storage (add later) ──────────────────────────
# Supabase project — https://supabase.com
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key is server-only — NEVER expose with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=
